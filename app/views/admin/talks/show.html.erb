<section id="show-talk" class="col-12">
  <div class="row">
    <div class="col-12">
      <article class="card">
        <h3 class="card-header"><%=@talk.title %></h3>
        <div class="card-body">
          <div class="sl_content_text"><%=simple_format sanitize(@talk.content.to_s.gsub(/\n/, '<br />'), :tags => %w(br img a)) %></div>
          <dl>
            <dt><%= t(:created_at, scope: [:activerecord, :attributes, :address]) %></dt>
            <dd><%= I18n.l @talk.created_at.to_date, :format => :long %></dd>
            <dt><%= t(:updated_at, scope: [:activerecord, :attributes, :address]) %></dt>
            <dd><%= I18n.l @talk.updated_at.to_date, :format => :long %></dd>
          </dl>
        </div>
      </article>
    </div>
  </div>
  <div class="row">
    <div class="col-12 col-xl-6">
      <%= link_to t(:link_list), admin_talks_path, class: 'btn btn-secondary' %>
    </div>
    <div class="col-12 col-xl-6 text-end">
      <%= link_to t(:edit), edit_admin_talk_path(@talk), class: 'btn btn-secondary' %>
      <%= link_to t(:delete), admin_talk_path(@talk), :method => :delete, :data => { :confirm => t(:delete_confirm) }, class: 'btn btn-danger' %>
    </div>
  </div>
</section>
